# 선반(shelf) 센서용 2차 게이트웨이 환경파일 예시.
#   복사해서 shelf.env 로 저장하고 값 채우기:  cp shelf.env.example shelf.env
#   shelf.env 는 .gitignore 됨 — 시크릿을 커밋하지 말 것.
#
# ⚠ GW_WEBAPP_URL·GW_KEYS_FILE·GW_QUEUE_DB 는 반드시 '함께' 지정한다.
#   하나라도 빠지면 게이트웨이가 시작 시 중단된다(선반 값이 농막 시트로 잘못 올라가는 사고 방지).

# 선반 시트 Apps Script 웹앱 /exec URL (새 시트에 Code.gs 를 SITE='선반'으로 배포하면 생성됨)
GW_WEBAPP_URL=https://script.google.com/macros/s/PASTE_SHELF_EXEC_URL/exec

# 게이트웨이 ↔ Code.gs 공유 시크릿 (선반 Code.gs 의 SECRET 과 똑같이)
FARMHUT_SECRET=PASTE_SHELF_SECRET

# 이 인스턴스 전용 센서키 파일(선반 bindkey) — 농막 sensor_keys.json 과 분리
GW_KEYS_FILE=/home/ryuch/smart-cabin/shelf_keys.json

# 이 인스턴스 전용 store-and-forward 큐 — 농막 gateway_queue.db 와 분리
GW_QUEUE_DB=/home/ryuch/smart-cabin/shelf_queue.db

# (선택) 농막과 다르게 하고 싶은 주기 등
# GW_CURRENT_COOLDOWN=60
# GW_AVG_BUCKET=3600
# GW_HISTORY_INTERVAL=86400
