#!/bin/bash
# 농막 LTE(6GB) 보호: Ryufarm(eth0) 기기가 LTE(eth1)로 나가는 것을 막는다.
#   - 허용 목록(/etc/farmhut/wan_allow, MAC)          → 항상 통과 (Shelly 히터 플러그: 기상청 예보·시각)
#   - 한도 목록(/etc/farmhut/wan_quota, MAC 하루MB 한달MB) → 하루·한 달 한도까지 통과(올리기+내려받기 합계).
#       하루 한도는 자정, 한 달 한도는 1일에 초기화. (Home Mini 50/500: 음성·알림은 늘 되고 음악은 한도에서 끊김)
#   - 그 밖의 기기                                    → 차단 (노트북·휴대폰·Tuya 등)
# Pi 자신의 통신·Ryufarm 안 기기끼리·휴대폰 핫스팟(wlan0) 경로는 건드리지 않는다.
# 설치: sudo bash scripts/install_wan_guard.sh  (→ /usr/local/sbin/farmhut-wan-guard, root 소유)
# 사용(sudo -n 허용됨):
#   apply        규칙 적용(오늘·이번 달 사용량을 이어서)
#   open SEC [MB] SEC초(60~86400) 동안 나머지 기기도 허용하되 합계 MB(기본 100, 최대 2048)까지 — 넘거나 시간이 끝나면
#                tick이 다시 막음. 한도 기기(Home Mini·휴대폰 등)의 하루·한 달 한도는 열린 동안에도 그대로
#   tick         매분(cron): 사용량 저장, 열림 종료·규칙 사라짐·날짜 바뀜이면 다시 적용.
#                한도를 처음 넘은 순간 "EXCEEDED 이름 하루|한달 MB" 한 줄 출력(알림용)
#   status       상태 한 줄 / print  적용할 규칙 출력(점검용)
set -u
PATH=/usr/sbin:/usr/bin:/sbin:/bin
ALLOW=/etc/farmhut/wan_allow
QUOTA=/etc/farmhut/wan_quota
VAR=/var/lib/farmhut; USED=$VAR/wan_quota_used
OPEN=/run/farmhut-wan-open-until
LAN=eth0; WAN=eth1; T=farmhut_wan
MARK0=0x4e480000          # 한도 기기 연결 표시(ct mark) = MARK0 + 번호
OPENMARK=0x4e48ff00       # 공유 열림 중 그 밖의 기기 연결 표시
AMARK0=0x4e48a000         # 항상 허용 기기 연결 표시 = AMARK0 + 번호(사용량만 셈, 제한 없음)
OPEN_MB_DEFAULT=100       # 공유 열림 동안 추가 기기 합계 상한(MB) 기본값(사용자 11-16)
OPEN_MB_MAX=2048
mkdir -p "$VAR"

macs() {
  [ -f "$ALLOW" ] || return 0
  grep -v '^\s*#' "$ALLOW" | tr 'A-F' 'a-f' | grep -oE '^([0-9a-f]{2}:){5}[0-9a-f]{2}' | paste -sd, -
}

# 항상 허용 목록 → "a번호 MAC 이름" 줄들(이름 = '#' 뒤 첫 단어)
alist() {
  [ -f "$ALLOW" ] || return 0
  grep -v '^\s*#' "$ALLOW" | awk '{ mac=tolower($1) } mac ~ /^([0-9a-f][0-9a-f]:){5}[0-9a-f][0-9a-f]$/ {
      name=mac; for (i=2;i<=NF;i++) if ($i=="#" && i<NF) { name=$(i+1); break } else if ($i ~ /^#./) { name=substr($i,2); break }
      print "a" n++, mac, name }'
  echo "api - Pi"      # Pi 자신(LTE 직접 입출력) — MAC 규칙 없이 input/output 체인에서 셈
}

# 한도 목록 → "번호 MAC 하루MB 한달MB 이름" 줄들
qlist() {
  [ -f "$QUOTA" ] || return 0
  # 이름 = '#' 뒤 첫 단어(공백 없는 한 단어로 적을 것)
  grep -v '^\s*#' "$QUOTA" | awk '{ mac=tolower($1) } NF>=3 && mac ~ /^([0-9a-f][0-9a-f]:){5}[0-9a-f][0-9a-f]$/ && $2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ {
      name=mac; for (i=4;i<=NF;i++) if ($i=="#" && i<NF) { name=$(i+1); break } else if ($i ~ /^#./) { name=substr($i,2); break }
      print n++, mac, $2, $3, name }'
}

period() { [ "$1" = d ] && date +%F || date +%Y-%m; }   # d=하루, m=한 달
label() { [ "$1" = d ] && echo 하루 || echo 한달; }

# 저장된 사용량(바이트): $1 번호, $2 d|m
used_saved() {
  [ -f "$USED" ] || { echo 0; return; }
  awk -v p="$(period "$2")" -v i="$1" -v k="$2" '$1==p && $2==i && $3==k {u=$4} END {print u+0}' "$USED"
}

# 지금 규칙의 사용량(바이트): $1 번호(한도 기기 0,1.. / 허용 기기 a0,a1..), $2 d|m (규칙 없으면 빈 값)
used_live() {
  local kind=quota obj="q$2$1"
  case "$1" in a*) kind=counter; obj="c$2$1" ;; esac
  nft -j list $kind inet $T "$obj" 2>/dev/null | python3 -c '
import sys, json
try:
    for o in json.load(sys.stdin)["nftables"]:
        if "quota" in o: print(o["quota"].get("used", 0)); break
        if "counter" in o: print(o["counter"].get("bytes", 0)); break
except Exception: pass'
}

save_used() {
  nft list table inet $T >/dev/null 2>&1 || return 0
  local tmp; tmp=$(mktemp)
  [ -f "$USED" ] && awk -v d="$(period d)" -v m="$(period m)" '$1==d || $1==m' "$USED" > "$tmp"
  while read -r i mac dmb mmb name; do
    for k in d m; do
      local u; u=$(used_live "$i" "$k"); [ -n "$u" ] || continue
      awk -v i="$i" -v k="$k" '!($2==i && $3==k)' "$tmp" > "$tmp.2"; mv "$tmp.2" "$tmp"
      echo "$(period "$k") $i $k $u $name" >> "$tmp"
    done
  done < <(qlist; alist | awk '{print $1, $2, 0, 0, $3}')
  mv "$tmp" "$USED"
}

ruleset() {
  echo "table inet $T {"
  while read -r j mac name; do
    echo "  counter cd$j { packets 0 bytes $(used_saved "$j" d) }"
    echo "  counter cm$j { packets 0 bytes $(used_saved "$j" m) }"
  done < <(alist)
  echo "  chain pi_in { type filter hook input priority -10; policy accept;"
  echo "    iifname \"$WAN\" counter name \"cdapi\" counter name \"cmapi\""
  echo "  }"
  echo "  chain pi_out { type filter hook output priority -10; policy accept;"
  echo "    oifname \"$WAN\" counter name \"cdapi\" counter name \"cmapi\""
  echo "  }"
  while read -r i mac dmb mmb name; do
    echo "  quota qd$i { over $dmb mbytes used $(used_saved "$i" d) bytes }"
    echo "  quota qm$i { over $mmb mbytes used $(used_saved "$i" m) bytes }"
  done < <(qlist)
  [ -f "$OPEN" ] && echo "  quota qopen { over $(open_mb) mbytes }"
  echo "  chain lan_wan {"
  echo "    type filter hook forward priority -10; policy accept;"
  while read -r i mac dmb mmb name; do
    local mk; mk=$(printf '0x%08x' $(( MARK0 + i )))
    echo "    iifname \"$LAN\" oifname \"$WAN\" ether saddr $mac ct mark set $mk"
    # 한도 계산·차단은 실제로 LTE(eth1)를 지나는 패킷만(11-16: LTE 때 맺은 연결이 경로가 Wi-Fi로 바뀐 뒤에도 세어지던 문제)
    for dir in oifname iifname; do
      echo "    ct mark $mk $dir \"$WAN\" quota name \"qd$i\" drop"     # 하루 먼저(한 달은 통과한 것만 셈)
      echo "    ct mark $mk $dir \"$WAN\" quota name \"qm$i\" drop"
    done
    echo "    ct mark $mk accept"
  done < <(qlist)
  while read -r j mac name; do     # 항상 허용: 제한 없이 LTE로 오간 올리기+내려받기 사용량만 셈
    [ "$mac" = "-" ] && continue
    local am; am=$(printf '0x%08x' $(( AMARK0 + ${j#a} )))
    echo "    iifname \"$LAN\" oifname \"$WAN\" ether saddr $mac ct mark set $am"
    for dir in oifname iifname; do
      echo "    ct mark $am $dir \"$WAN\" counter name \"cd$j\" counter name \"cm$j\""
    done
    echo "    ct mark $am accept"
  done < <(alist)
  if [ -f "$OPEN" ]; then   # 공유 열림: 나머지 기기도 통과하되 열린 동안 LTE 합계 상한(넘으면 차단)
    echo "    iifname \"$LAN\" oifname \"$WAN\" ct mark set $OPENMARK"
    for dir in oifname iifname; do
      echo "    ct mark $OPENMARK $dir \"$WAN\" quota name \"qopen\" drop"
    done
    echo "    ct mark $OPENMARK accept"
  fi
  echo "    iifname \"$LAN\" oifname \"$WAN\" counter drop"
  echo "  }"
  echo "}"
}

apply() {
  save_used
  rm -f "$OPEN"
  nft delete table inet $T 2>/dev/null
  ruleset | nft -f - || { echo "nft 적용 실패"; return 1; }
  period d > "$VAR/wan_day"
  echo "차단 적용: 항상 허용 $(alist | grep -vc ' - ')대, 한도 $(qlist | grep -c .)대"
}

open_until() { awk '{print $1+0}' "$OPEN" 2>/dev/null || echo 0; }
open_mb() { awk '{print ($2 ? $2 : 100)}' "$OPEN" 2>/dev/null || echo 100; }

open_for() {
  local s="$1" mb="${2:-$OPEN_MB_DEFAULT}"
  [[ "$s" =~ ^[0-9]+$ ]] && [ "$s" -ge 60 ] && [ "$s" -le 86400 ] || { echo "open SEC [MB]: SEC 60~86400"; return 2; }
  [[ "$mb" =~ ^[0-9]+$ ]] && [ "$mb" -ge 10 ] && [ "$mb" -le "$OPEN_MB_MAX" ] || { echo "open SEC [MB]: MB 10~$OPEN_MB_MAX"; return 2; }
  save_used
  echo "$(( $(date +%s) + s )) $mb" > "$OPEN"
  rm -f "$VAR/wan_open_exceeded"
  nft delete table inet $T 2>/dev/null
  ruleset | nft -f - || { rm -f "$OPEN"; echo "nft 적용 실패"; apply >/dev/null; return 1; }
  echo "공유 열림: $(( s / 60 ))분 동안($(date -d @"$(open_until)" +%H:%M)까지), 추가 기기 합계 ${mb}MB까지"
}

open_used() {
  nft -j list quota inet $T qopen 2>/dev/null | python3 -c '
import sys, json
try:
    for o in json.load(sys.stdin)["nftables"]:
        if "quota" in o: print(o["quota"].get("used", 0)); break
except Exception: pass'
}

quota_line() {
  local out=""
  while read -r i mac dmb mmb name; do
    local ud um; ud=$(used_live "$i" d); [ -n "$ud" ] || ud=$(used_saved "$i" d)
    um=$(used_live "$i" m); [ -n "$um" ] || um=$(used_saved "$i" m)
    out="$out · $name 오늘 $(( ud / 1048576 ))/${dmb}MB, 이번 달 $(( um / 1048576 ))/${mmb}MB"
    [ "$ud" -ge $(( dmb * 1048576 )) ] && out="$out(오늘 한도 도달)"
    [ "$um" -ge $(( mmb * 1048576 )) ] && out="$out(이달 한도 도달)"
  done < <(qlist)
  while read -r j mac name; do
    local ad am2; ad=$(used_live "$j" d); [ -n "$ad" ] || ad=$(used_saved "$j" d)
    am2=$(used_live "$j" m); [ -n "$am2" ] || am2=$(used_saved "$j" m)
    if [ "$mac" = "-" ]; then
      out="$out · $name 자체 오늘 $(( ad / 1048576 ))MB, 이번 달 $(( am2 / 1048576 ))MB"
    else
      out="$out · $name(항상 허용) 오늘 $(( ad / 1048576 ))MB, 이번 달 $(( am2 / 1048576 ))MB"
    fi
  done < <(alist)
  echo "$out"
}

status() {
  if [ -f "$OPEN" ]; then
    local u; u=$(open_used); echo "공유 열림 ~$(date -d @"$(open_until)" +%m-%d\ %H:%M) · 추가 기기 $(( ${u:-0} / 1048576 ))/$(open_mb)MB$(quota_line)"
  elif nft list table inet $T >/dev/null 2>&1; then
    local n; n=$(nft list chain inet $T lan_wan 2>/dev/null | grep -oE 'packets [0-9]+' | tail -1 | awk '{print $2}')
    echo "차단 중 · 막은 패킷 ${n:-0}$(quota_line)"
  else
    echo "규칙 없음(모두 허용)$(quota_line)"
  fi
}

tick() {
  if [ -f "$OPEN" ]; then
    local ou; ou=$(open_used)
    if [ -n "$ou" ] && [ "$ou" -ge $(( $(open_mb) * 1048576 )) ]; then
      echo "EXCEEDED 공유 열림 $(open_mb)MB"; apply >/dev/null      # 상한 도달 → 시간이 남아도 다시 차단
    elif [ "$(date +%s)" -ge "$(open_until)" ]; then
      apply >/dev/null
    fi
  elif ! nft list table inet $T >/dev/null 2>&1; then
    apply >/dev/null
  elif [ "$(cat "$VAR/wan_day" 2>/dev/null)" != "$(period d)" ]; then
    apply >/dev/null                      # 날짜가 바뀜 → 하루 한도 0부터(달이 바뀌면 한 달도)
  fi
  save_used
  while read -r i mac dmb mmb name; do     # 한도를 처음 넘은 순간 한 줄(기간마다 한 번)
    for k in d m; do
      local u lim; u=$(used_live "$i" "$k"); [ -n "$u" ] || continue
      [ "$k" = d ] && lim=$dmb || lim=$mmb
      local flag="$VAR/wan_exceeded_$(period "$k")_${i}_$k"
      if [ "$u" -ge $(( lim * 1048576 )) ] && [ ! -f "$flag" ]; then
        touch "$flag"; echo "EXCEEDED $name $(label "$k") ${lim}MB"
      fi
    done
  done < <(qlist)
  find "$VAR" -maxdepth 1 -name 'wan_exceeded_*' -mtime +40 -delete 2>/dev/null
  return 0
}

case "${1:-}" in
  apply) apply ;;
  open) open_for "${2:-}" "${3:-}" ;;
  tick) tick ;;
  status) status ;;
  print) ruleset ;;
  *) echo "사용: $0 apply|open SEC|tick|status|print"; exit 2 ;;
esac
