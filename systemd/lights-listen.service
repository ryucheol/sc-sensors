[Unit]
Description=433 MHz remote listener (lights) -> lights_state.json
After=pigpiod.service
Wants=pigpiod.service

[Service]
Type=simple
User=ryuch
WorkingDirectory=/home/ryuch/smart-cabin
ExecStart=/usr/bin/python3 /home/ryuch/smart-cabin/lights/lights.py daemon
Restart=always
RestartSec=30
Nice=10

[Install]
WantedBy=multi-user.target
