[Unit]
Description=Telegram bot receiver (commands from allowed chat -> heater_cmd, replies)
After=network-online.target heater-control.service
Wants=network-online.target

[Service]
Type=simple
User=ryuch
WorkingDirectory=/home/ryuch/smart-cabin
ExecStart=/usr/bin/python3 /home/ryuch/smart-cabin/notify/telegram_bot.py
Restart=always
RestartSec=20
Nice=5

[Install]
WantedBy=multi-user.target
