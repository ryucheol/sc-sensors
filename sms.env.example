# 문자 명령 통로(notify/sms_bot.py) 설정 — 이 파일을 sms.env로 복사해 채운다(sms.env는 gitignore)
SMS_ALLOWED=01012345678          # 명령을 받을 번호(쉼표로 여러 개)
SMS_PREFIX=비밀단어              # 명령 앞에 붙일 단어. 예: '비밀단어 상태'
SMS_MONTH_MAX=80                 # 한 달 발송 상한(문자 조각 수). 요금제 무료 100건 안쪽
SMS_REPLY_MAX=130                # 답장 최대 글자(한글 70자 넘으면 2조각)
SMS_ALARM=1                      # 인터넷 끊김 중 중요 경보 문자
SMS_ALARM_AFTER_MIN=20           # 텔레그램이 이만큼 못 나가면 '끊김'으로 봄
SMS_ALARM_REPEAT_H=6             # 같은 경보 재발송 간격
