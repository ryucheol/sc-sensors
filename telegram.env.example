# 복사해서 ~/smart-cabin/telegram.env 로 저장하고 실제 값을 넣으세요(chmod 600).
# telegram.env 는 .gitignore 처리됨(커밋 금지). 설정 방법: docs/TELEGRAM.ko.md
TELEGRAM_BOT_TOKEN=PUT-BOT-TOKEN-HERE
# 받을 사람(=명령을 허락할 사람). 직접 넣지 말고 `python3 notify/telegram_bot.py bind ryucheol` 로 채우기
TELEGRAM_CHAT_ID=PUT-CHAT-ID-HERE
# (선택) 명령을 더 허락할 숫자 id, 쉼표로. 그룹에서 쓰려면 그룹 id와 내 id를 모두
#TELEGRAM_ALLOWED_IDS=
